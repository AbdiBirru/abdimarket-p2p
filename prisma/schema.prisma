generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  ELECTRONICS
  CLOTHING
  HOME
  ACCESSORIES
  VEHICLES
  BOOKS
  FOOD
  SERVICES
  OTHER
}

enum PaymentMethod {
  CASH
  CBE_BIRR
  TELEBIRR
  BANK_TRANSFER
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum ReportReason {
  PROHIBITED_ITEM
  SCAM_OR_FRAUD
  SPAM
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  password        String
  name            String
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  listings        Listing[]
  savedListings   SavedListing[]
  reports         Report[]
  reviewsReceived Review[]       @relation("SellerReviews")
  reviewsWritten  Review[]       @relation("ReviewerReviews")
}

model Listing {
  id                String          @id @default(cuid())
  title             String
  photos            String[]
  category          Category
  price             Int?
  location          String
  paymentMethods    PaymentMethod[]
  deliveryAvailable Boolean         @default(false)
  phone             String
  details           String?
  status            ListingStatus   @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  seller            User            @relation(fields: [sellerId], references: [id])
  sellerId          String
  savedBy           SavedListing[]
  reports           Report[]

  @@index([status, category])
  @@index([createdAt])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Report {
  id         String       @id @default(cuid())
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  reporter   User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String

  @@unique([listingId, reporterId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  seller     User   @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   String
  reviewer   User   @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String

  @@unique([sellerId, reviewerId])
}
