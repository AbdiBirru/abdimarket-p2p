generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  ELECTRONICS
  CLOTHING
  HOME
  ACCESSORIES
  VEHICLES
  BOOKS
  FOOD
  SERVICES
  OTHER
}

enum PaymentMethod {
  CASH
  CBE_BIRR
  TELEBIRR
  BANK_TRANSFER
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id                String          @id @default(cuid())
  title             String
  photos            String[]
  category          Category
  price             Int?
  location          String
  paymentMethods    PaymentMethod[]
  deliveryAvailable Boolean         @default(false)
  phone             String
  status            ListingStatus   @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  seller            User            @relation(fields: [sellerId], references: [id])
  sellerId          String

  @@index([status, category])
  @@index([createdAt])
}
